{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beep Gen",
  "identifier": "io.github.iseohyun.beepgen",
  "build": {
    "frontendDist": "../../../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "windows": [
      {
        "title": "Beep Gen",
        "width": 720,
        "height": 900,
        "minWidth": 380,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; media-src 'self' blob:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
